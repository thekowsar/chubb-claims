# Copy to .env and change as needed. docker compose reads .env automatically.
# Every value has a default in docker-compose.yml, so .env is optional for a local demo.
# Never commit a real .env.

# HS256 signing key for JWTs, at least 32 characters. Use a long random value outside local demos.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Password given to every seed user on the first start (empty database only).
SEED_DEMO_PASSWORD=Password123!

# Host ports. CLIENT_PORT is also added to the server's CORS allow-list.
SERVER_PORT=8080
CLIENT_PORT=4200
